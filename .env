
import streamlit as st
import pandas as pd

# Page configuration
st.set_page_config(
    page_title="Student Parent Notification",
    page_icon="📚",
    layout="wide"
)

# Application heading
st.title("Student Marks & Parent Notification System")

st.write(
    "Upload student marks Excel file "
    "and generate notifications for parents."
)

# Upload Excel file
uploaded_file = st.file_uploader(
    "Upload Student Excel File",
    type=["xlsx"]
)

if uploaded_file is not None:

    # Read Excel file
    df = pd.read_excel(
        uploaded_file,
        dtype={
            "USN": str,
            "FATHER_MOBILE": str,
            "MOTHER_MOBILE": str
        }
    )

    # Display uploaded data
    st.success("Excel file uploaded successfully!")

    st.subheader("Student Records")

    st.dataframe(df, use_container_width=True)

    # Display number of students
    total_students = df["USN"].nunique()

    st.metric(
        "Total Students",
        total_students
    )

    # Select student
    student_list = df["NAME"].dropna().unique()

    selected_student = st.selectbox(
        "Select Student",
        student_list
    )

    # Filter selected student
    student_data = df[
        df["NAME"] == selected_student
    ]

    st.subheader("Student Marks")

    st.dataframe(
        student_data[
            ["USN", "SUBJECT", "MARKS", "MAX_MARKS"]
        ],
        use_container_width=True
    )

    # Generate message
    first_row = student_data.iloc[0]

    message = f"""
Dear Parent,

Your ward's academic performance:

Student Name: {first_row['NAME']}

USN: {first_row['USN']}

Subject-wise Marks:
"""

    for _, row in student_data.iterrows():

        message += (
            f"\n{row['SUBJECT']}: "
            f"{row['MARKS']}/{row['MAX_MARKS']}"
        )

    message += """

Kindly review your ward's academic performance.

Regards,
School of Engineering and Technology
"""

    # Display message
    st.subheader("Parent Message Preview")

    st.text_area(
        "Generated Message",
        message,
        height=250
    )

    # Display parent mobile numbers
    st.subheader("Parent Contact Details")

    st.write(
        "Father Mobile:",
        first_row["FATHER_MOBILE"]
    )

    st.write(
        "Mother Mobile:",
        first_row["MOTHER_MOBILE"]
    )
